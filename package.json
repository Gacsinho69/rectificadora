{
  "name": "rectificadora-plataforma",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.servidor.config.ts",
    "start": "node --env-file-if-exists=.env dist-servidor/servidor.js",
    "equipo": "node --env-file-if-exists=.env dist-servidor/equipo.js",
    "test": "vitest run",
    "tipos": "tsc --noEmit",
    "migracion": "drizzle-kit generate",
    "demo:reiniciar": "node -e \"require('node:fs').rmSync('.datos/desarrollo',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/archivo": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "antd": "^6.6.7",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@hono/vite-dev-server": {
      "@hono/node-server": "2.1.5",
      "minimatch": "11.0.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
