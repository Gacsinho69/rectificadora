# La configuración del servidor de producción. En el proveedor van como variables de entorno; para probar en un
# computador, copia este archivo como .env (que no se sube al repositorio) y `npm start` lo lee solo.

# La base PostgreSQL. Si el proveedor la entrega con ?sslmode=require, va tal cual.
DATABASE_URL=postgres://usuario:clave@servidor:5432/rectificadora

# El dominio del sistema, sin https:// ni barras. Cada rectificadora queda en rectificadora.cl/c/<subdominio> y, si el
# DNS tiene el comodín *.rectificadora.cl apuntando al mismo servidor, también en <subdominio>.rectificadora.cl.
DOMINIO_PLATAFORMA=rectificadora.cl

# El puerto donde atiende (el proveedor suele fijarlo solo).
# PORT=3000

# Solo para un servidor de muestra: con la base vacía, siembra la demostración (todas sus personas con la clave demo1234).
# DEMOSTRACION=si
